{
  "name": "classicmp",
  "version": "0.1.0",
  "description": "A lightweight Linux-first media player powered by mpv.",
  "author": { "name": "Zambezi Blue", "email": "opensource@zambeziblue.com" },
  "main": "dist/src/main/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "npm run build && CLASSICMP_ENV=development electron .",
    "build": "tsc -p tsconfig.json && vite build --config vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "format": "prettier --write .",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.config.ts tests/integration && tsx scripts/validate-linux.ts",
    "test:e2e": "npm run build && tsx scripts/e2e-smoke.ts",
    "test:accessibility": "vitest run --config vitest.config.ts tests/accessibility",
    "test:package": "tsx scripts/verify-package.ts",
    "package": "npm run build && electron-builder",
    "package:appimage": "npm run build && electron-builder --linux AppImage",
    "package:deb": "npm run build && electron-builder --linux deb",
    "start": "electron ."
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/static": "^8.1.0",
    "fastify": "^5.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2",
    "sql.js": "^1.13.0",
    "mpris-service": "^2.1.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.19.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "wait-on": "^8.0.3",
    "@types/sql.js": "^1.4.9",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3"
  },
  "build": {
    "appId": "com.zambeziblue.classicmp",
    "productName": "ClassicMP",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo;Player;",
      "executableName": "classicmp"
    },
    "deb": {
      "packageName": "classicmp"
    },
    "directories": {
      "output": "release"
    }
  },
  "allowScripts": {
    "electron@34.5.8": true
  }
}
